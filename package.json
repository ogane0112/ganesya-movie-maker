{
  "name": "ganesya-movie-maker",
  "version": "0.1.0",
  "private": true,
  "description": "台本(Markdown)から解説動画を作るCLI。AIエージェントが検査結果とキーフレームを見て自分で直せることを重視する。",
  "type": "module",
  "bin": {
    "gmm": "./bin/gmm.mjs"
